generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; these are validated in app code.
// Role: OWNER | ADMIN | MEMBER
// ChannelType: TEXT | VOICE
// Status: ONLINE | IDLE | DND | OFFLINE

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  discriminator String   @default("0001")
  email         String   @unique
  password      String
  avatarColor   String   @default("#5865F2")
  avatarUrl     String?
  bannerUrl     String?
  bannerColor   String   @default("#4C3B2C")
  bio           String?
  pronouns      String?
  youtubeUrl    String?
  spotifyUrl    String?
  status        String   @default("OFFLINE")
  customStatus  String?
  isBot         Boolean  @default(false)
  createdAt     DateTime @default(now())

  memberships    ServerMember[]
  messages       Message[]
  ownedServers   Server[]        @relation("ServerOwner")
  reactions      Reaction[]
  dmMembers      DMMember[]
  pollVotes      PollVote[]
  reports        Report[]

  @@index([username])
}

model Server {
  id             String   @id @default(cuid())
  name           String
  icon           String?
  description    String?
  category       String?
  tags           String? // comma-separated, simple MVP tagging
  isDiscoverable Boolean  @default(true)
  inviteCode     String   @unique
  ownerId        String
  owner          User     @relation("ServerOwner", fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())

  members  ServerMember[]
  channels Channel[]
}

model ServerMember {
  id       String   @id @default(cuid())
  userId   String
  serverId String
  role     String   @default("MEMBER")
  nickname String?
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

model Channel {
  id        String      @id @default(cuid())
  name      String
  type      String      @default("TEXT")
  topic     String?
  position  Int         @default(0)
  serverId  String
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  messages Message[]
}

model DMChannel {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  members   DMMember[]
  messages  Message[]
}

model DMMember {
  id          String    @id @default(cuid())
  userId      String
  dmChannelId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dmChannel   DMChannel @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)

  @@unique([userId, dmChannelId])
}

model Message {
  id          String     @id @default(cuid())
  type        String     @default("TEXT") // TEXT | POLL
  content     String
  edited      Boolean    @default(false)
  attachment  String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channelId   String?
  channel     Channel?   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dmChannelId String?
  dmChannel   DMChannel? @relation(fields: [dmChannelId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  reactions Reaction[]
  poll      Poll?
  reports   Report[]

  @@index([channelId])
  @@index([dmChannelId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  messageId String       @unique
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  options PollOption[]
}

model PollOption {
  id       String     @id @default(cuid())
  text     String
  position Int        @default(0)
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Report {
  id         String   @id @default(cuid())
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED
  messageId  String
  reporterId String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([messageId])
}
